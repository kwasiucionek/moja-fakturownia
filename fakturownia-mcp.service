[Unit]
Description=Fakturownia — serwer MCP asystenta
After=network.target fakturownia.service

[Service]
User=fakturownia
Group=www-data
WorkingDirectory=/cytrus/fakturownia
EnvironmentFile=/cytrus/fakturownia/.env

ExecStart=/cytrus/fakturownia/venv/bin/uvicorn assistant.mcp_server:app \
    --host 127.0.0.1 \
    --port 8501 \
    --proxy-headers \
    --forwarded-allow-ips=127.0.0.1 \
    --log-level info

Restart=on-failure
RestartSec=5
SyslogIdentifier=fakturownia-mcp

[Install]
WantedBy=multi-user.target
